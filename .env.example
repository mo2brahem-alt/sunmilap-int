# ============================================================
# Shopify Dev Dashboard app
# ============================================================
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# App Proxy:
# Storefront URL: /apps/sunmi-pay
# Backend proxy URL: /proxy

# ============================================================
# Public backend URL on Coolify
# Example: https://pay.sunmilab.com
# ============================================================
PUBLIC_BASE_URL=https://pay.example.com

# ============================================================
# Kashier
# Start with test, then switch to live after successful testing
# ============================================================
KASHIER_MODE=test
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MERCHANT_ID=
KASHIER_ALLOWED_METHODS=card,wallet
KASHIER_SESSION_MINUTES=20

# Use a long random value, 40+ characters.
# It is embedded in the webhook URL path and must never be exposed in the theme.
KASHIER_WEBHOOK_TOKEN=

# IMPORTANT:
# The current build captures Kashier webhook payloads but DOES NOT auto-complete
# paid Shopify draft orders until the exact Kashier webhook signature/status
# structure is confirmed from your dashboard documentation.
KASHIER_WEBHOOK_AUTOCOMPLETE=false

# ============================================================
# UI / Security
# ============================================================
STORE_ORIGIN=https://your-store-domain.com
PORT=3000
