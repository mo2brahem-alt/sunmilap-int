    font-size: 0.78rem;
    line-height: 1.5;
  }

  .sunmi-product-order__payment-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    justify-content: end;
  }

  .sunmi-product-order__payment-badges b {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 3px 7px;
    border: 1px solid #ddd5e8;
    border-radius: 6px;
    background: #ffffff;
    color: #3a2b4d !important;
    font-size: 0.68rem;
    font-weight: 850;
  }

  .sunmi-product-order__error {
    margin: 16px 0 0;
    padding: 12px 14px;
    border: 1px solid #f3c7c7;
    border-radius: 10px;
    background: #fff1f1 !important;
    color: #a41414 !important;
    font-weight: 700;
  }

  .sunmi-product-order__summary {
    position: sticky;
    top: 24px;
    align-self: start;
    padding: 22px;
    border: 1px solid #e6daf7;
    border-radius: 20px;
    background: var(--sunmi-order-purple-soft) !important;
  }

  .sunmi-product-order__summary h3 {
    margin: 0 0 18px;
    color: var(--sunmi-order-text) !important;
    font-size: 1.25rem;
  }

  .sunmi-product-order__product {
    display: grid;
    gap: 5px;
    padding-bottom: 16px;
    border-bottom: 1px solid #ddcfef;
  }

  .sunmi-product-order__product strong {
    color: var(--sunmi-order-text) !important;
    overflow-wrap: anywhere;
  }

  .sunmi-product-order__product span {
    color: var(--sunmi-order-muted) !important;
    font-size: 0.88rem;
  }

  .sunmi-product-order__quantity-row {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    color: var(--sunmi-order-text);
  }

  .sunmi-product-order__quantity {
    display: grid;
    grid-template-columns: 40px minmax(48px, 66px) 40px;
    overflow: hidden;
    border: 1px solid #d8c9ed;
    border-radius: 10px;
    background: #ffffff;
  }

  .sunmi-product-order__quantity button,
  .sunmi-product-order__quantity input {
    min-height: 40px;
    border: 0;
    background: #ffffff !important;
    color: var(--sunmi-order-text) !important;
    text-align: center;
    font: inherit;
  }

  .sunmi-product-order__quantity button {
    cursor: pointer;
    font-size: 1.15rem;
  }

  .sunmi-product-order__quantity button:hover {
    background: #eee5fa !important;
    color: var(--sunmi-order-purple) !important;
  }

  .sunmi-product-order__quantity input {
    width: 100%;
    border-inline: 1px solid #d8c9ed;
    appearance: textfield;
  }

  .sunmi-product-order__quantity input::-webkit-inner-spin-button,
  .sunmi-product-order__quantity input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }

  .sunmi-product-order__total {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 2px solid #d8c5f1;
    color: var(--sunmi-order-text);
    font-size: 1.05rem;
  }

  .sunmi-product-order__total strong {
    color: var(--sunmi-order-purple) !important;
    font-size: 1.25rem;
  }

  .sunmi-product-order__note {
    margin: 12px 0 0;
    color: var(--sunmi-order-muted) !important;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .sunmi-product-order__submit {
    display: block;
    width: 100%;
    min-height: 56px;
    margin-top: 20px;
    padding: 14px 20px;
    border: 0;
    border-radius: 14px;
    background:
      linear-gradient(
        135deg,
        var(--sunmi-order-purple),
        var(--sunmi-order-purple-dark)
      ) !important;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff;
    font: inherit;
    font-weight: 850;
    cursor: pointer;
    box-shadow: 0 12px 30px rgb(106 54 190 / 0.25);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .sunmi-product-order__submit:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 16px 34px rgb(106 54 190 / 0.3);
  }

  .sunmi-product-order__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }


  .sunmi-product-order__shipping {
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid var(--sunmi-order-border);
  }

  .sunmi-product-order__shipping-options:empty {
    display: none;
  }

  .sunmi-product-order__shipping-price {
    color: var(--sunmi-order-purple) !important;
    white-space: nowrap;
  }

  .sunmi-product-order__summary-lines {
    display: grid;
    gap: 10px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #ddcfef;
  }

  .sunmi-product-order__summary-lines > div {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }

  .sunmi-product-order__summary-lines strong {
    color: var(--sunmi-order-text) !important;
  }

  .sunmi-payment-return-status[hidden] {
    display: none !important;
  }

  .sunmi-payment-return-status {
    width: min(1180px, calc(100% - 32px));
    margin: 18px auto 0;
    padding: 14px 18px;
    border: 1px solid #d8c5f1;
    border-radius: 14px;
    background: #f8f4ff !important;
    color: var(--sunmi-order-purple-dark) !important;
    text-align: center;
    font-weight: 800;
  }

  .sunmi-pay-modal[hidden] {
    display: none !important;
  }

  .sunmi-pay-modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: grid;
    place-items: center;
    padding: 18px;
  }

  .sunmi-pay-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(20 11 31 / 0.68);
    backdrop-filter: blur(4px);
  }

  .sunmi-pay-modal__dialog {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(1040px, 100%);
    height: min(820px, calc(100dvh - 36px));
    overflow: hidden;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 30px 90px rgb(0 0 0 / 0.35);
  }

  .sunmi-pay-modal__iframe {
    width: 100%;
    min-height: 0;
    flex: 1 1 auto;
    border: 0;
    background: #fff;
  }

  .sunmi-pay-modal__fallback {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    padding: 10px 58px 10px 16px;
    border-top: 1px solid #eee7f6;
    background: #fbf9ff;
    color: #6f6579;
    font-size: 13px;
    text-align: center;
  }

  .sunmi-pay-modal__fallback button {
    border: 0;
    border-radius: 10px;
    padding: 9px 14px;
    background: var(--sunmi-order-purple);
    color: #fff;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .sunmi-pay-modal__close {
    position: absolute;
    z-index: 3;
    top: 10px;
    inset-inline-end: 10px;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.94);
    color: #21172f;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 18px rgb(0 0 0 / 0.12);
  }

  .sunmi-pay-modal__status {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    background: #fff;
    color: var(--sunmi-order-text);
    text-align: center;
    font-weight: 800;
  }

  html.sunmi-pay-open {
    overflow: hidden;
  }

  .sunmi-product-order__success {
    display: grid;
    place-items: center;
    min-height: 340px;
    padding: 36px 18px;
    text-align: center;
  }

  .sunmi-product-order__success-icon {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    margin-bottom: 16px;
    border-radius: 50%;
    background: var(--sunmi-order-purple-soft);
    color: var(--sunmi-order-purple);
    font-size: 34px;
    font-weight: 900;
  }

  .sunmi-product-order__success h3 {
    margin: 0 0 8px;
    color: var(--sunmi-order-text) !important;
  }

  .sunmi-product-order__success p {
    margin: 0;
    color: var(--sunmi-order-muted) !important;
  }

  [dir='rtl'] .sunmi-product-order__form,
  [dir='rtl'] .sunmi-product-order__summary {
    text-align: right;
  }

  @media screen and (max-width: 990px) {
    .sunmi-product-order__shell {
      grid-template-columns: 1fr;
    }

    .sunmi-product-order__summary {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    .sunmi-pay-modal {
      padding: 0;
    }

    .sunmi-pay-modal__dialog {
      width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 0;
    }

    .sunmi-pay-modal__fallback {
      padding-inline: 14px 54px;
    }

    .sunmi-product-order {
      padding:
        max(28px, var(--sunmi-order-padding-top))
        10px
        max(42px, var(--sunmi-order-padding-bottom));
    }

    .sunmi-product-order__shell {
      gap: 24px;
      padding: 16px;
      border-radius: 20px;
    }

    .sunmi-product-order__fields {
      grid-template-columns: 1fr;
    }

    .sunmi-product-order__wide {
      grid-column: auto;
    }

    .sunmi-product-order__summary {
      padding: 16px;
    }

    .sunmi-product-order__payment-head {
      display: grid;
      align-items: start;
    }

    .sunmi-product-order__payment-option {
      grid-template-columns: 22px minmax(0, 1fr);
      align-items: start;
    }

    .sunmi-product-order__payment-badges {
      grid-column: 2;
      justify-content: start;
      margin-top: 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer order form",
  "tag": "section",
  "class": "sunmi-product-customer-form-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add this section to any product template where you want the customer shipping form to appear."
    },
    {
      "type": "color_scheme",
      "id": "offer_form_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "offer_form_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "offer_form_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Customer order form"
    }
  ]
}
{% endschema %}