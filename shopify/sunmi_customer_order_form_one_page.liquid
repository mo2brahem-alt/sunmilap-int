    box-shadow: 0 0 0 3px rgb(106 54 190 / 0.08);
  }

  .sunmi-product-order__payment-option > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .sunmi-product-order__payment-radio {
    width: 20px;
    height: 20px;
    border: 2px solid #c8bdd7;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: inset 0 0 0 4px #ffffff;
  }

  .sunmi-product-order__payment-option.is-selected .sunmi-product-order__payment-radio {
    border-color: var(--sunmi-order-purple);
    background: var(--sunmi-order-purple);
  }

  .sunmi-product-order__payment-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .sunmi-product-order__payment-copy strong {
